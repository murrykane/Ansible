global
    log /dev/log local0
    maxconn 2048
    daemon

defaults
    mode tcp
    timeout connect 10s
    timeout client  1m
    timeout server  1m

frontend k8s_api
    bind *:6443
    default_backend k8s_backend

backend k8s_backend
    mode tcp
    balance roundrobin
    option tcp-check
    server rke2-prod-1 rke2-prod-1.kane.mk:6443 check
    server rke2-prod-2 rke2-prod-2.kane.mk:6443 check
    server rke2-prod-3 rke2-prod-3.kane.mk:6443 check
    server rke2-prod-6 rke2-prod-6.kane.mk:6443 check

